# Copy to .env and fill in. Variables set in the shell take precedence.

# Data curator added to every record as contributorType "DataCurator".
# Leave IGSN_CURATOR_NAME empty to add no curator.
IGSN_CURATOR_NAME="FamilyName, GivenName"
IGSN_CURATOR_ORCID=                      # e.g. https://orcid.org/0000-0000-0000-0000
IGSN_CURATOR_AFFILIATION="Kiel University"
IGSN_CURATOR_AFFILIATION_ROR=https://ror.org/04v76ef78

# Ollama server, e.g. the GPU machine through an SSH tunnel.
# OLLAMA_HOST=http://localhost:11434
